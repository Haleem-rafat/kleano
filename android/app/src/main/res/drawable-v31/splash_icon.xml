<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash icon. The empty first layer sets the icon's full 288dp
     size, so the system does not stretch the logo past its circular mask. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="288dp" android:height="288dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:width="96dp"
        android:height="63dp"
        android:gravity="center"
        android:drawable="@drawable/launch_logo" />
</layer-list>
