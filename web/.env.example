# Copy to .env.local. Nothing here is a secret except where noted.

# The Kleano API, server side only. Defaults to the live backend when unset.
# For local testing point it at a local backend, for example http://localhost:3000/api.
KLEANO_API_URL=https://kleano-backend.onrender.com/api

# Google Maps JavaScript API and Geocoding API, restricted to this site's domains in Google Cloud.
# It reaches the browser by design. Without it, adding a saved place, the guest catalogue and the
# live map show a clear "not set up" state.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
